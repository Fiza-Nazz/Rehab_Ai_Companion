# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rehab_companion

# Gemini API (used for AI exercise generation)
GEMINI_API_KEY=your-gemini-api-key-here

# Redis (for Celery broker and backend)
REDIS_URL=redis://localhost:6379/0

# SendGrid (Email alerts)
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=alerts@rehabcompanion.com

# Playwright WhatsApp automation — persistent browser session directory
# First time: run a one-time script to scan QR and save session
PLAYWRIGHT_USER_DATA_DIR=./playwright_session

# Security
SECRET_KEY=your-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
ENVIRONMENT=development
DEBUG=true
